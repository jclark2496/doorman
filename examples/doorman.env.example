# /opt/doorman/doorman.env — read by doorman.service. Nothing secret belongs here: doorman holds
# no shared code, no signing key and no API token, which is why this file is only 0640.
#
# systemd reads it, and the runbook sources it with sh, so quote any value holding a space or a
# shell metacharacter. `AUTH_RP_NAME=Some Site` is read by sh as the assignment `AUTH_RP_NAME=Some`
# followed by the command `Site`, and cost a real deployment. Both readers strip the quotes, so
# quoting costs nothing. A test in this repo sources this file on every run.
AUTH_PORT=8401
AUTH_ORIGIN=https://example.com
AUTH_RP_ID=example.com
AUTH_RP_NAME="Example"
AUTH_COOKIE_DOMAIN=.example.com
AUTH_COOKIE_NAME=doorman_session
AUTH_DB=/opt/doorman/data/auth.db
AUTH_SESSION_DAYS=30
AUTH_RENEW_DAYS=15
AUTH_OWNER_NAME=ada
AUTH_HOSTS=example.com,notes.example.com,photos.example.com,files.example.com,archive.example.com
AUTH_SITE_ALIASES=notes=notes.example.com,photos=photos.example.com,files=files.example.com,archive=archive.example.com
